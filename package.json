{
  "name": "codovate",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm --prefix frontend ci",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix frontend test",
    "preview": "npm --prefix frontend run preview",
    "firebase:setup": "node scripts/firebase-setup.mjs",
    "firebase:configure": "node scripts/firebase-setup.mjs --configure-only",
    "test:setup": "node --test scripts/firebase-setup.test.mjs scripts/deploy-onboarding.test.mjs",
    "deploy:onboarding": "node scripts/deploy-onboarding.mjs",
    "discovery:sync": "node scripts/sync-student-discovery.mjs --project=codovate-dev"
  }
}
