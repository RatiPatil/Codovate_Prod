rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
  function own(uid) { return signedIn() && request.auth.uid == uid; }
  function text(v, max) { return v is string && v.size() <= max; }
  function changedTime() { return request.resource.data.updatedAt == request.time; }
  function validSkillLabels(s) {
   // Round-trip equality rejects non-string or multiline skill labels.
   let joined = s.join('\n');
   return joined.split('\n') == s
    && joined.matches('[^\\n\\r]{1,60}(\\n[^\\n\\r]{1,60}){0,19}');
  }
  function validSkills(s) {
   // Empty optional lists need no string/regex validation.
   return s is list && (s.size()==0 || (s.size()<=20
    && s.toSet().size()==s.size() && validSkillLabels(s)));
  }
  function validCareerPreferences(p) {
   // Every required field is read below; a missing field fails closed.
   return p is map && p.keys().hasOnly(['desiredRole','domain','experience','goals','seeking','availability','mode','yearOfStudy','justStarting'])
    && text(p.desiredRole,100)
    && p.domain in ['','Web Development','AI/ML','Data Science','Cyber Security','Startups','Research','Hackathons','Other']
    && p.experience in ['','Beginner','Intermediate','Advanced']
    && p.goals is list && p.goals.size()<=6 && p.goals.toSet().size()==p.goals.size()
    && p.goals.hasOnly(['Internships','Jobs','Hackathons','Project collaboration','Research','Startups'])
    && p.seeking is list && p.seeking.size()<=4 && p.seeking.toSet().size()==p.seeking.size()
    && p.seeking.hasOnly(['Hackathon Teammates','Project Collaborators','Startup Co-founders','Research Partners'])
    && p.availability in ['Not sure yet','1-5 hours/week','6-10 hours/week','10+ hours/week']
    && p.mode in ['Remote','On-site','Hybrid'] && p.justStarting is bool
    && p.yearOfStudy in ['','First year','Second year','Third year','Fourth year','Final year','Graduated','Other'];
  }
  function onboardingCompleteProfile(d) {
   let p = d.get('careerPreferences',{});
   // validProfile validates the preferences map once before this completeness check.
   return d.name==d.name.upper()
    && d.name.matches('[^ ]+( [^ ]+)+') && d.college.size()>0 && d.degree.size()>0 && d.graduationYear.size()==4
    && p.yearOfStudy!='' && p.desiredRole.size()>0 && p.domain!='' && p.experience!='' && p.goals.size()>0
    && (d.skills.size()>0 || p.justStarting);
  }
  function validOnboarding(d) {
   let o = d.onboarding;
   return o is map && o.keys().hasOnly(['version','status','step','startedAt','completedAt'])
    && o.version==1 && o.step is int && o.step>=1 && o.step<=4 && o.startedAt is timestamp && o.startedAt==d.createdAt
    && ((o.status=='in-progress' && o.completedAt==null)
      || (o.status=='completed' && o.step==4 && o.completedAt is timestamp && onboardingCompleteProfile(d)));
  }
  function validNameParts(p) {
   // String concatenation rejects non-string parts; the bounded regex also rejects embedded newlines.
   let joined = p.first+'\n'+p.middle+'\n'+p.last;
   return p is map && p.keys().hasOnly(['first','middle','last'])
    && joined.matches("([\\p{L}\\p{M}][\\p{L}\\p{M}'’ .-]{0,39})?\n([\\p{L}\\p{M}][\\p{L}\\p{M}'’ .-]{0,39})?\n([\\p{L}\\p{M}][\\p{L}\\p{M}'’ .-]{0,39})?");
  }
  function validOnboardingIdentity(d) {
   let n = d.nameParts;
   // The full-name regex already rejects leading, trailing and doubled spaces.
   return d.name==n.first+' '+n.middle+' '+n.last
    && d.mobile.matches('^\\+91[6-9][0-9]{9}$')
    && d.city.matches("[\\p{L}\\p{M}][\\p{L}\\p{M}'’ .-]{1,99}")
    && d.bio.size()>=20;
  }
  function onboardingTransition() {
   let before = resource.data.get('onboarding',{});
   let after = request.resource.data.get('onboarding',{});
   // Existing owners may enroll once; validProfile anchors startedAt to createdAt.
   return before == {} ? (after == {} || after.status=='in-progress') : (
     before.version==after.version && before.startedAt==after.startedAt
     && ((before.status=='completed' && before==after)
       || (before.status=='in-progress' && (after.status=='in-progress'
         || (after.status=='completed' && after.completedAt==request.time && validOnboardingIdentity(request.resource.data)
           && request.resource.data.get('program','').size()>0 && request.resource.data.careerPreferences.seeking.size()>0)))));
  }

  function validProfileExtras(d, changed) {
   // Only changed optional fields need revalidation; required fields are checked below.
   return (!changed.hasAny(['resumeUrl']) || optionalHttps(d.get('resumeUrl','')))
    && (!changed.hasAny(['mobile']) || (text(d.get('mobile',''),16)
      && (d.get('mobile','') == '' || d.mobile.matches('^\\+91[6-9][0-9]{9}$'))))
    && (!changed.hasAny(['taluka']) || text(d.get('taluka',''),100))
    && (!changed.hasAny(['suggestedSkills']) || validSkills(d.get('suggestedSkills',[])))
    && (!changed.hasAny(['discoveryEnabled']) || d.get('discoveryEnabled',false) == false)
    && (!changed.hasAny(['mobileVerified']) || d.get('mobileVerified',false) == false)
    && (!changed.hasAny(['accountStatus']) || d.get('accountStatus','') in ['','invited'])
    && (!changed.hasAny(['importSource']) || text(d.get('importSource',''),100))
    && (!changed.hasAny(['skillSuggestionsSource']) || text(d.get('skillSuggestionsSource',''),100));
  }
  function validTeammateCard(c) {
   return c is map && c.keys().hasOnly(['photoUrl','achievements','passions'])
    && text(c.photoUrl,500) && (c.photoUrl=='' || c.photoUrl.matches('https://(avatars[.]githubusercontent[.]com|lh3[.]googleusercontent[.]com)/.*'))
    && validSkills(c.achievements) && c.achievements.size()<=6
    && c.passions is list && c.passions.size()<=6 && c.passions.toSet().size()==c.passions.size()
    && c.passions.hasOnly(['AI Products','Hackathons','Open Source','Research','Entrepreneurship','Community Projects']);
  }
  function validProfile(d) {
   // New documents have a strict shape. Legacy unknown fields may remain, but cannot change.
   // Every changed supported field is validated; required fields must exist after the update.
   let changed = request.method=='update' ? d.diff(resource.data).affectedKeys() : d.keys().toSet();
   return d.keys().hasAll(['name','email','college','degree','graduationYear','city','bio','skills','portfolio','resumePath','createdAt','updatedAt'])
    && (request.method=='update' ? changed : d.keys().toSet()).hasOnly(['name','email','college','degree','graduationYear','city','bio','skills','portfolio','resumePath','resumeUrl','mobile','taluka','program','suggestedSkills','skillSuggestionsSource','onboarding','careerPreferences','nameParts','teammateCard','discoveryEnabled','accountStatus','mobileVerified','importSource','createdAt','updatedAt'])
    && (!changed.hasAny(['name']) || text(d.name,100))
    && (!changed.hasAny(['email']) || text(d.email,320))
    && (!changed.hasAny(['college']) || text(d.college,180))
    && (!changed.hasAny(['degree']) || text(d.degree,100))
    && (!changed.hasAny(['program']) || text(d.get('program',''),180))
    && (!changed.hasAny(['graduationYear']) || (text(d.graduationYear,4) && d.graduationYear.matches('^(20[0-9]{2}|2100)?$')))
    && (!changed.hasAny(['city']) || text(d.city,100))
    && (!changed.hasAny(['bio']) || text(d.bio,1500))
    && (!changed.hasAny(['skills']) || validSkills(d.skills))
    && (!changed.hasAny(['portfolio']) || (text(d.portfolio,500) && (d.portfolio=='' || d.portfolio.matches('https://.*'))))
    && (!changed.hasAny(['resumePath']) || d.resumePath=='' || d.resumePath=='resumes/'+request.auth.uid+'/resume.pdf')
    && (!changed.hasAny(['resumeUrl','mobile','taluka','suggestedSkills','discoveryEnabled','mobileVerified','accountStatus','importSource','skillSuggestionsSource']) || validProfileExtras(d,changed))
    && (!changed.hasAny(['nameParts']) || !d.keys().hasAny(['nameParts']) || validNameParts(d.nameParts))
    && (!changed.hasAny(['teammateCard']) || !d.keys().hasAny(['teammateCard']) || validTeammateCard(d.teammateCard))
    && (!changed.hasAny(['careerPreferences']) || !d.keys().hasAny(['careerPreferences']) || validCareerPreferences(d.careerPreferences))
    && (!d.keys().hasAny(['onboarding']) || (changed.hasAny(['onboarding']) ? validOnboarding(d) : (d.onboarding.status!='completed' || onboardingCompleteProfile(d))))
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /users/{uid} {
   allow read: if own(uid);
   allow create: if own(uid) && validProfile(request.resource.data)
    && !request.resource.data.keys().hasAny(['accountStatus','importSource','skillSuggestionsSource'])
    && request.resource.data.email == request.auth.token.get('email', '')
    && (request.auth.token.get('email', '') != '' || request.auth.token.get('phone_number', '') != '')
    && (!request.resource.data.keys().hasAny(['onboarding']) || request.resource.data.onboarding.status=='in-progress')
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if own(uid) && validProfile(request.resource.data) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboarding']) || onboardingTransition())
    && request.resource.data.get('accountStatus','') == resource.data.get('accountStatus','')
    && request.resource.data.get('importSource','') == resource.data.get('importSource','')
    && request.resource.data.get('skillSuggestionsSource','') == resource.data.get('skillSuggestionsSource','')
    && request.resource.data.email == resource.data.get('email',request.auth.token.get('email',''))
    && request.resource.data.createdAt == resource.data.get('createdAt',request.time) && changedTime();
   allow delete: if false;
  }
  match /publicStats/{id} {
   allow get: if id == 'community';
   allow list,create,delete: if false;
   allow update: if id == 'community' && signedIn()
    && request.resource.data.keys().hasAll(['registeredStudents','updatedAt'])
    && request.resource.data.keys().hasOnly(['registeredStudents','updatedAt'])
    && resource.data.registeredStudents is int
    && request.resource.data.registeredStudents == resource.data.registeredStudents + 1
    && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdAt == request.time
    && changedTime();
  }
  match /adminUsers/{uid} {
   allow get: if admin() || own(uid);
   allow list: if admin();
   allow create,update: if own(uid)
    && request.resource.data.keys().hasAll(['uid','fullName','joinedAt','updatedAt'])
    && request.resource.data.keys().hasOnly(['uid','fullName','joinedAt','updatedAt'])
    && request.resource.data.uid == uid && text(request.resource.data.fullName,200)
    && existsAfter(/databases/$(database)/documents/users/$(uid))
    && request.resource.data.fullName == getAfter(/databases/$(database)/documents/users/$(uid)).data.name
    && request.resource.data.joinedAt == getAfter(/databases/$(database)/documents/users/$(uid)).data.createdAt
    && request.resource.data.joinedAt is timestamp && changedTime();
   allow delete: if false;
  }
  function validListing(d) {
   return d.keys().hasAll(['title','organization','type','category','mode','location','duration','stipend','skills','deadline','closesAt','description','responsibilities','eligibility','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','organization','type','category','mode','location','duration','stipend','skills','deadline','closesAt','description','responsibilities','eligibility','status','createdBy','createdAt','updatedAt'])
    && text(d.title,180) && d.title.size()>0 && text(d.organization,180) && d.organization.size()>0
    && d.type in ['internship','job','competition','hackathon']
    && d.category in ['Technology','Design','Marketing','Business','Finance','Other']
    && d.mode in ['Remote','On-site','Hybrid'] && text(d.location,180) && text(d.duration,180)
    && d.stipend is number && d.stipend>=0 && d.stipend<=10000000
    && validSkills(d.skills) && text(d.deadline,50) && d.closesAt is timestamp
    && text(d.description,6000) && text(d.responsibilities,6000) && text(d.eligibility,6000)
    && d.status in ['draft','published','closed'] && d.createdBy is string
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /opportunities/{id} {
   allow read: if resource.data.status == 'published' || admin();
   allow create: if admin() && validListing(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && changedTime()
    && request.resource.data.closesAt > request.time;
   allow update: if admin() && validListing(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if false;
  }
  match /applications/{id} {
   // Owners can read their deterministic ID before creation for duplicate-safe transactions.
   allow get: if admin() || (signedIn() && id.matches(request.auth.uid + '_.*'));
   allow list: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['studentId','opportunityId','opportunityTitle','organization','studentName','college','resumePath','resumeUrl','coverNote','status','createdAt','updatedAt'])
    && request.resource.data.studentId == request.auth.uid
    && text(request.resource.data.opportunityId,128)
    && id == request.auth.uid + '_' + request.resource.data.opportunityId
    && request.resource.data.status == 'submitted'
    && request.resource.data.createdAt == request.time && changedTime()
    && text(request.resource.data.coverNote,2000)
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.studentName.size()>0
    && request.resource.data.college == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.college
    && request.resource.data.college.size()>0
    && (request.resource.data.resumePath == 'resumes/' + request.auth.uid + '/resume.pdf' || (request.resource.data.resumePath == '' && request.resource.data.get('resumeUrl','').size()>0))
    && optionalHttps(request.resource.data.get('resumeUrl',''))
    && request.resource.data.get('resumeUrl','') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('resumeUrl','')
    && request.resource.data.resumePath == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.resumePath
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'published'
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.closesAt > request.time
    && request.resource.data.opportunityTitle == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.title
    && request.resource.data.organization == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organization;
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status in ['submitted','under_review','shortlisted','selected','rejected'] && changedTime();
   allow delete: if false;
  }
  match /bookmarks/{id} {
   allow read: if signedIn() && resource.data.studentId == request.auth.uid;
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['studentId','opportunityId','title','organization','type','createdAt'])
    && request.resource.data.studentId == request.auth.uid
    && text(request.resource.data.opportunityId,128)
    && id == request.auth.uid + '_' + request.resource.data.opportunityId
    && request.resource.data.createdAt == request.time
    && request.resource.data.title == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.title
    && request.resource.data.organization == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organization
    && request.resource.data.type == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.type
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'published';
   allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
   allow update: if false;
  }
  function validTask(d) {
   return d.keys().hasAll(['studentId','title','note','dueDate','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','title','note','dueDate','status','createdAt','updatedAt'])
    && d.studentId is string && text(d.title,120) && d.title.size()>0 && text(d.note,1000)
    && d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.status in ['todo','done'] && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /careerTasks/{id} {
   allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
   allow create: if signedIn() && validTask(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'todo'
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if signedIn() && (resource.data.studentId == request.auth.uid || admin())
    && validTask(request.resource.data) && request.resource.data.studentId == resource.data.studentId
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
  }
  function validResource(d) {
   return d.keys().hasAll(['title','description','url','category','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','description','url','category','status','createdBy','createdAt','updatedAt'])
    && text(d.title,120) && d.title.size()>0 && text(d.description,1000) && d.description.size()>0
    && text(d.url,1000) && d.url.matches('https://[^ /]+.*')
    && d.category in ['Interview prep','Resume & portfolio','Technical skills','Career guidance']
    && d.status in ['draft','published'] && d.createdBy is string
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /resources/{id} {
   allow read: if resource.data.status == 'published' || admin();
   allow create: if admin() && validResource(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if admin() && validResource(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if admin();
  }
  function validCommunity(d) {
   return text(d.studentId,128) && d.studentId.size()>0 && text(d.studentName,100) && d.studentName.size()>0
    && text(d.title,120) && d.title.size()>0 && text(d.summary,2000) && d.summary.size()>0
    && d.category in ['Web & apps','AI & data','Design','Hardware','Social impact','Other']
    && validSkills(d.skills) && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  function optionalHttps(v) { return text(v,500) && (v == '' || v.matches('https://[^ /]+.*')); }
  function validProject(d) {
   return d.keys().hasAll(['studentId','studentName','title','summary','category','skills','visibility','moderation','repoUrl','demoUrl','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','title','summary','category','skills','visibility','moderation','repoUrl','demoUrl','createdAt','updatedAt'])
    && validCommunity(d) && d.visibility in ['private','public'] && d.moderation in ['visible','hidden']
    && optionalHttps(d.repoUrl) && optionalHttps(d.demoUrl);
  }
  match /projects/{id} {
   allow read: if (resource.data.visibility == 'public' && resource.data.moderation == 'visible') || own(resource.data.studentId) || admin();
   allow create: if signedIn() && validProject(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.moderation == 'visible'
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if validProject(request.resource.data) && changedTime()
    && request.resource.data.studentId == resource.data.studentId && request.resource.data.studentName == resource.data.studentName
    && request.resource.data.createdAt == resource.data.createdAt
    && (admin() || (own(resource.data.studentId) && resource.data.moderation == 'visible' && request.resource.data.moderation == resource.data.moderation));
   allow delete: if own(resource.data.studentId) || admin();
  }
  function validTeam(d) {
   return d.keys().hasAll(['studentId','studentName','title','summary','category','skills','lookingFor','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','title','summary','category','skills','lookingFor','status','createdAt','updatedAt'])
    && validCommunity(d) && text(d.lookingFor,180) && d.lookingFor.size()>0 && d.status in ['open','closed','hidden'];
  }
  match /teams/{id} {
   allow read: if signedIn() && (resource.data.status != 'hidden' || own(resource.data.studentId) || admin());
   allow create: if signedIn() && validTeam(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.status in ['open','closed']
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if validTeam(request.resource.data) && changedTime()
    && request.resource.data.studentId == resource.data.studentId && request.resource.data.studentName == resource.data.studentName
    && request.resource.data.createdAt == resource.data.createdAt
    && (admin() || (own(resource.data.studentId) && resource.data.status != 'hidden' && request.resource.data.status in ['open','closed']));
   // Close teams instead of deleting them: existing request references stay valid.
   allow delete: if false;
  }
  function validTeamRequest(d) {
   return d.keys().hasAll(['studentId','studentName','ownerId','teamId','teamTitle','note','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','ownerId','teamId','teamTitle','note','status','createdAt','updatedAt'])
    && text(d.studentId,128) && text(d.studentName,100) && d.studentName.size()>0
    && text(d.ownerId,128) && text(d.teamId,128) && d.teamId.size()>0 && text(d.teamTitle,120)
    && text(d.note,1000) && d.note.size()>0 && d.status in ['pending','accepted','declined','withdrawn']
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /teamRequests/{id} {
   // Missing-document reads contain no private data and enable duplicate-safe transactions.
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/teamRequests/$(id)) || own(resource.data.studentId) || own(resource.data.ownerId) || admin());
   allow list: if signedIn() && (own(resource.data.studentId) || own(resource.data.ownerId) || admin());
   allow create: if signedIn() && validTeamRequest(request.resource.data)
    && request.resource.data.studentId == request.auth.uid
    && id == request.auth.uid + '_' + request.resource.data.teamId
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.ownerId == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.studentId
    && request.resource.data.ownerId != request.auth.uid
    && request.resource.data.teamTitle == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.title
    && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.status == 'open'
    && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && changedTime();
   allow update: if signedIn() && validTeamRequest(request.resource.data) && changedTime()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && ((own(resource.data.studentId) && resource.data.status in ['pending','accepted'] && request.resource.data.status == 'withdrawn')
     || ((own(resource.data.ownerId) || admin()) && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']));
   allow delete: if false;
  }
  function validMentorSession(d) {
   return d.keys().hasAll(['title','mentorName','topic','description','startsAt','durationMinutes','format','location','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','mentorName','topic','description','startsAt','durationMinutes','format','location','status','createdBy','createdAt','updatedAt'])
    && text(d.title,120) && d.title.size()>0 && text(d.mentorName,100) && d.mentorName.size()>0
    && d.topic in ['Interview practice','Career direction','Resume review','Project feedback','Team & hackathon guidance','Portfolio walkthrough']
