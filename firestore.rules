    && ((c.kind == 'direct' && acceptedConnection(c.connectionId)) || c.kind == 'group')));
  }
  function chatWritable(id) {
   let c=get(/databases/$(database)/documents/conversations/$(id)).data;
   return chatAccess(id) && (c.kind=='direct' || (c.kind=='group' && c.status=='active') || (c.kind=='team' && get(/databases/$(database)/documents/projectTeams/$(c.teamId)).data.lifecycle=='active'));
  }
  match /conversations/{id} {
   allow get: if signedIn() && ((!exists(/databases/$(database)/documents/conversations/$(id)) && id.matches('dm_.*'))
    || (resource.data.kind in ['direct','team'] && chatAccess(id))
    || (resource.data.kind == 'group' && (request.auth.uid in resource.data.members || pendingGroupInvite(id))));
   allow list: if signedIn() && resource.data.kind == 'group' && request.auth.uid in resource.data.members;
   allow create: if signedIn() && (
    (validGroup(request.resource.data) && request.resource.data.ownerId == request.auth.uid
     && request.resource.data.members == [request.auth.uid] && request.resource.data.status == 'active'
     && request.resource.data.createdAt == request.time && changedTime())
    || (request.resource.data.keys().hasAll(['kind','teamId','createdAt']) && request.resource.data.keys().hasOnly(['kind','teamId','createdAt'])
     && request.resource.data.kind=='team' && request.resource.data.teamId==id && getAfter(/databases/$(database)/documents/projectTeams/$(id)).data.ownerId==request.auth.uid
     && getAfter(/databases/$(database)/documents/projectTeams/$(id)).data.createdAt==request.time && request.resource.data.createdAt==request.time)
    || (request.resource.data.keys().hasAll(['kind','connectionId','members','createdAt'])
     && request.resource.data.keys().hasOnly(['kind','connectionId','members','createdAt'])
     && request.resource.data.kind == 'direct' && text(request.resource.data.connectionId,257)
     && id == 'dm_' + request.resource.data.connectionId && acceptedConnection(request.resource.data.connectionId)
     && request.resource.data.members == [get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.fromId,get(/databases/$(database)/documents/connections/$(request.resource.data.connectionId)).data.toId]
     && request.resource.data.createdAt == request.time));
   allow update: if signedIn() && resource.data.kind == 'group' && validGroup(request.resource.data) && changedTime()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','status','updatedAt'])
    && ((own(resource.data.ownerId) && request.resource.data.members.hasOnly(resource.data.members))
     || (request.resource.data.status == resource.data.status
      && ((request.auth.uid in resource.data.members && request.auth.uid != resource.data.ownerId
       && !(request.auth.uid in request.resource.data.members)
       && request.resource.data.members.hasOnly(resource.data.members)
       && request.resource.data.members.size() == resource.data.members.size()-1)
      || (resource.data.status == 'active' && !(request.auth.uid in resource.data.members) && request.auth.uid in request.resource.data.members
       && request.resource.data.members.hasAll(resource.data.members)
       && request.resource.data.members.size() == resource.data.members.size()+1
       && pendingGroupInvite(id)
       && getAfter(/databases/$(database)/documents/groupInvites/$(id + '_' + request.auth.uid)).data.status == 'accepted'))));
   allow delete: if false;
   match /typing/{uid} {
    allow read: if chatAccess(id);
    allow create,update: if own(uid) && chatAccess(id) && request.resource.data.keys().hasAll(['uid','active','updatedAt']) && request.resource.data.keys().hasOnly(['uid','active','updatedAt'])
     && request.resource.data.uid==uid && request.resource.data.active is bool && changedTime() && (!request.resource.data.active || chatWritable(id));
    allow delete: if own(uid) && chatAccess(id);
   }
   match /readReceipts/{uid} {
    allow read: if chatAccess(id);
    allow create,update: if own(uid) && chatAccess(id) && request.resource.data.keys().hasAll(['uid','lastMessageId','lastReadAt']) && request.resource.data.keys().hasOnly(['uid','lastMessageId','lastReadAt'])
     && request.resource.data.uid==uid && text(request.resource.data.lastMessageId,128) && request.resource.data.lastMessageId.size()>0
     && exists(/databases/$(database)/documents/conversations/$(id)/messages/$(request.resource.data.lastMessageId)) && request.resource.data.lastReadAt==request.time;
    allow delete: if false;
   }
   match /messages/{messageId} {
    allow read: if chatAccess(id);
    allow create: if chatAccess(id)
     && (get(/databases/$(database)/documents/conversations/$(id)).data.kind == 'direct' || (get(/databases/$(database)/documents/conversations/$(id)).data.kind=='team' && get(/databases/$(database)/documents/projectTeams/$(id)).data.lifecycle=='active') || (get(/databases/$(database)/documents/conversations/$(id)).data.kind=='group' && get(/databases/$(database)/documents/conversations/$(id)).data.status == 'active'))
     && request.resource.data.keys().hasAll(['senderId','senderName','text','createdAt'])
     && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
     && request.resource.data.senderId == request.auth.uid
     && text(request.resource.data.senderName,100) && request.resource.data.senderName.trim().size()>0
     && request.resource.data.senderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
     && text(request.resource.data.text,1500) && request.resource.data.text.size()>0
     && request.resource.data.createdAt == request.time;
    allow update,delete: if false;
   }
  }
  match /groupInvites/{id} {
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/groupInvites/$(id)) || own(resource.data.studentId) || own(resource.data.ownerId));
   allow list: if signedIn() && (own(resource.data.studentId) || own(resource.data.ownerId));
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['groupId','ownerId','studentId','status','createdAt','updatedAt'])
    && request.resource.data.keys().hasOnly(['groupId','ownerId','studentId','status','createdAt','updatedAt'])
    && text(request.resource.data.groupId,128) && text(request.resource.data.studentId,128)
    && request.resource.data.studentId != request.auth.uid && request.resource.data.ownerId == request.auth.uid
    && id == request.resource.data.groupId + '_' + request.resource.data.studentId
    && groupOwner(request.resource.data.groupId)
    && get(/databases/$(database)/documents/conversations/$(request.resource.data.groupId)).data.status == 'active'
    && !(request.resource.data.studentId in get(/databases/$(database)/documents/conversations/$(request.resource.data.groupId)).data.members)
    && exists(/databases/$(database)/documents/memberProfiles/$(request.resource.data.studentId))
    && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && changedTime();
   allow update: if signedIn() && changedTime()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && ((own(resource.data.studentId) && resource.data.status == 'pending'
      && (request.resource.data.status == 'declined' || (request.resource.data.status == 'accepted'
       && getAfter(/databases/$(database)/documents/conversations/$(resource.data.groupId)).data.status == 'active'
       && resource.data.studentId in getAfter(/databases/$(database)/documents/conversations/$(resource.data.groupId)).data.members)))
     || (groupOwner(resource.data.groupId) && request.resource.data.status == 'revoked' && resource.data.status == 'pending')
     || (groupOwner(resource.data.groupId) && request.resource.data.status == 'pending'
      && !(resource.data.studentId in get(/databases/$(database)/documents/conversations/$(resource.data.groupId)).data.members)
      && get(/databases/$(database)/documents/conversations/$(resource.data.groupId)).data.status == 'active'));
   allow delete: if false;
  }

  function projectMember(id) { return signedIn() && exists(/databases/$(database)/documents/projectTeams/$(id)) && request.auth.uid in get(/databases/$(database)/documents/projectTeams/$(id)).data.members; }
  function projectLeader(id) { return signedIn() && get(/databases/$(database)/documents/projectTeams/$(id)).data.ownerId == request.auth.uid; }
  function projectInvited(id) { return signedIn() && exists(/databases/$(database)/documents/projectTeamInvites/$(id+'_'+request.auth.uid)) && get(/databases/$(database)/documents/projectTeamInvites/$(id+'_'+request.auth.uid)).data.status == 'pending'; }
  function projectSnapshot(d) { return {'ownerId':d.ownerId,'title':d.title,'description':d.description,'requiredSkills':d.requiredSkills,'capacity':d.capacity,'recruitment':d.recruitment,'lifecycle':d.lifecycle,'members':d.members,'roles':d.roles,'version':d.version}; }
  function validProjectTeam(d) {
   return d.keys().hasAll(['ownerId','title','description','requiredSkills','capacity','recruitment','lifecycle','members','roles','version','historyId','createdAt','updatedAt'])
    && d.keys().hasOnly(['ownerId','title','description','requiredSkills','capacity','recruitment','lifecycle','members','roles','version','historyId','createdAt','updatedAt'])
    && text(d.ownerId,128) && text(d.title,100) && d.title.size()>0 && text(d.description,2000) && d.description.size()>0
    && validSkills(d.requiredSkills) && d.capacity is int && d.capacity>=2 && d.capacity<=12
    && d.members is list && d.members.size()>0 && d.members.size()<=d.capacity && d.members.toSet().size()==d.members.size()
    && d.roles is map && d.roles.keys().hasOnly(d.members) && d.roles.keys().hasAll(d.members)
    && d.roles.values().hasOnly(['leader','member','mentor']) && d.roles.get(d.ownerId,'')=='leader'
    && d.roles.values().removeAll(['member','mentor']).size()==1
    && d.lifecycle in ['active','archived'] && d.recruitment in ['open','recruiting','closed']
    && (d.lifecycle=='active' || d.recruitment=='closed') && d.version is int && d.version>=1
    && text(d.historyId,128) && d.historyId.size()>0 && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  function projectListing(id,d) { return {'teamId':id,'ownerId':d.ownerId,'title':d.title,'description':d.description,'requiredSkills':d.requiredSkills,'capacity':d.capacity,'memberCount':d.members.size(),'recruitment':d.recruitment,'lifecycle':d.lifecycle,'version':d.version,'updatedAt':d.updatedAt}; }
  function projectAudit(id,d) {
   let h=getAfter(/databases/$(database)/documents/projectTeams/$(id)/history/$(d.historyId)).data;
   return h.teamId==id && h.actorId==request.auth.uid && h.createdAt==request.time && h.snapshot==projectSnapshot(d)
    && getAfter(/databases/$(database)/documents/teamListings/$(id)).data==projectListing(id,d);
  }
  function projectAcceptedInvite(id,uid) { return exists(/databases/$(database)/documents/projectTeamInvites/$(id+'_'+uid)) && get(/databases/$(database)/documents/projectTeamInvites/$(id+'_'+uid)).data.status=='pending' && getAfter(/databases/$(database)/documents/projectTeamInvites/$(id+'_'+uid)).data.status=='accepted'; }
  function projectAcceptedRequest(id,uid) { return exists(/databases/$(database)/documents/projectTeamRequests/$(id+'_'+uid)) && get(/databases/$(database)/documents/projectTeamRequests/$(id+'_'+uid)).data.status=='pending' && getAfter(/databases/$(database)/documents/projectTeamRequests/$(id+'_'+uid)).data.status=='accepted'; }
  function projectAdded(d,old) { return d.members.size()==old.members.size()+1 && d.members.hasAll(old.members); }
  function validTaskDate(value) {
   return value=='' || (value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && int(value.split('-')[0])>=1 && timestamp.date(int(value.split('-')[0]),int(value.split('-')[1]),int(value.split('-')[2])).day()==int(value.split('-')[2]) && timestamp.date(int(value.split('-')[0]),int(value.split('-')[1]),int(value.split('-')[2])).month()==int(value.split('-')[1]));
  }
  function validTeamTask(d) {
   return d.keys().hasAll(['title','description','assigneeId','dueDate','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','description','assigneeId','dueDate','status','createdBy','createdAt','updatedAt'])
    && text(d.title,160) && d.title.size()>0 && d.title.matches('[^\\n\\r]+')
    && text(d.description,800) && text(d.assigneeId,128) && text(d.createdBy,128) && d.createdBy.size()>0
    && validTaskDate(d.dueDate) && d.status in ['todo','doing','done'] && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /projectTeams/{id} {
   allow get: if projectMember(id) || projectInvited(id);
   allow list: if signedIn() && request.auth.uid in resource.data.members;
   allow create: if signedIn() && validProjectTeam(request.resource.data) && own(request.resource.data.ownerId)
    && request.resource.data.members==[request.auth.uid] && request.resource.data.roles.get(request.auth.uid,'')=='leader'
    && request.resource.data.version==1 && request.resource.data.lifecycle=='active'
    && request.resource.data.createdAt==request.time && changedTime() && projectAudit(id,request.resource.data)
    && getAfter(/databases/$(database)/documents/conversations/$(id)).data.kind=='team';
   allow update: if signedIn() && validProjectTeam(request.resource.data) && changedTime()
    && request.resource.data.ownerId==resource.data.ownerId && request.resource.data.createdAt==resource.data.createdAt
    && request.resource.data.version==resource.data.version+1 && request.resource.data.historyId!=resource.data.historyId
    && projectAudit(id,request.resource.data)
    && ((own(resource.data.ownerId) && request.resource.data.members.hasOnly(resource.data.members))
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','roles','version','historyId','updatedAt'])
      && ((own(resource.data.ownerId) && projectAdded(request.resource.data,resource.data)
        && projectAcceptedRequest(id,request.resource.data.members.removeAll(resource.data.members)[0])
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly(request.resource.data.members.removeAll(resource.data.members))
        && request.resource.data.roles.get(request.resource.data.members.removeAll(resource.data.members)[0],'')=='member'
        && resource.data.lifecycle=='active' && resource.data.recruitment!='closed')
       || (!(request.auth.uid in resource.data.members) && projectAdded(request.resource.data,resource.data)
        && request.resource.data.members.removeAll(resource.data.members)==[request.auth.uid]
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.roles.get(request.auth.uid,'')=='member' && resource.data.lifecycle=='active' && resource.data.recruitment!='closed'
        && projectAcceptedInvite(id,request.auth.uid))
       || (request.auth.uid in resource.data.members && request.auth.uid!=resource.data.ownerId
        && resource.data.members.removeAll(request.resource.data.members)==[request.auth.uid]
        && request.resource.data.members.size()==resource.data.members.size()-1 && request.resource.data.members.hasOnly(resource.data.members)
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([request.auth.uid])))));
   allow delete: if false;
   match /tasks/{taskId} {
    allow read: if projectMember(id);
    allow create: if projectMember(id) && get(/databases/$(database)/documents/projectTeams/$(id)).data.lifecycle=='active'
     && validTeamTask(request.resource.data) && request.resource.data.createdBy==request.auth.uid
     && request.resource.data.createdAt==request.time && changedTime() && request.resource.data.status=='todo'
     && (request.resource.data.assigneeId=='' || request.resource.data.assigneeId in get(/databases/$(database)/documents/projectTeams/$(id)).data.members);
    allow update: if projectMember(id) && get(/databases/$(database)/documents/projectTeams/$(id)).data.lifecycle=='active'
     && validTeamTask(request.resource.data) && changedTime() && request.resource.data.createdBy==resource.data.createdBy && request.resource.data.createdAt==resource.data.createdAt
     && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) || own(resource.data.createdBy) || projectLeader(id))
     && (request.resource.data.assigneeId==resource.data.assigneeId || request.resource.data.assigneeId=='' || request.resource.data.assigneeId in get(/databases/$(database)/documents/projectTeams/$(id)).data.members);
    allow delete: if projectMember(id) && get(/databases/$(database)/documents/projectTeams/$(id)).data.lifecycle=='active' && (own(resource.data.createdBy) || projectLeader(id));
   }
   match /history/{eventId} {
    allow read: if projectMember(id);
    allow create: if signedIn() && request.resource.data.keys().hasAll(['teamId','actorId','snapshot','createdAt'])
     && request.resource.data.keys().hasOnly(['teamId','actorId','snapshot','createdAt'])
     && request.resource.data.teamId==id && request.resource.data.actorId==request.auth.uid && request.resource.data.createdAt==request.time
     && getAfter(/databases/$(database)/documents/projectTeams/$(id)).data.historyId==eventId
     && getAfter(/databases/$(database)/documents/projectTeams/$(id)).data.updatedAt==request.time
     && request.resource.data.snapshot==projectSnapshot(getAfter(/databases/$(database)/documents/projectTeams/$(id)).data);
    allow update,delete: if false;
   }
  }
  match /teamListings/{id} {
   allow read: if signedIn() && (resource.data.lifecycle=='active' || own(resource.data.ownerId));
   allow create,update: if signedIn() && request.resource.data==projectListing(id,getAfter(/databases/$(database)/documents/projectTeams/$(id)).data)
    && request.resource.data.updatedAt==request.time;
   allow delete: if false;
  }
  function validProjectEntry(d,invite) { return d.keys().hasAll(['teamId','ownerId','studentId','status','createdAt','updatedAt'])
   && (invite?d.keys().hasOnly(['teamId','ownerId','studentId','status','createdAt','updatedAt']):d.keys().hasOnly(['teamId','ownerId','studentId','status','note','createdAt','updatedAt']))
   && text(d.teamId,128) && text(d.studentId,128) && d.studentId!=d.ownerId
   && d.ownerId==get(/databases/$(database)/documents/projectTeams/$(d.teamId)).data.ownerId
   && (invite || (text(d.note,1000) && d.note.size()>0)) && d.createdAt is timestamp && d.updatedAt is timestamp; }
  function projectAvailable(id) {let t=get(/databases/$(database)/documents/projectTeams/$(id)).data; return t.lifecycle=='active' && t.recruitment!='closed' && t.members.size()<t.capacity;}
  match /projectTeamInvites/{id} {
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/projectTeamInvites/$(id)) || own(resource.data.studentId) || own(resource.data.ownerId));
   allow list: if signedIn() && (own(resource.data.studentId) || own(resource.data.ownerId));
   allow create: if signedIn() && validProjectEntry(request.resource.data,true) && id==request.resource.data.teamId+'_'+request.resource.data.studentId
    && own(request.resource.data.ownerId) && projectAvailable(request.resource.data.teamId)
    && !(request.resource.data.studentId in get(/databases/$(database)/documents/projectTeams/$(request.resource.data.teamId)).data.members)
    && exists(/databases/$(database)/documents/memberProfiles/$(request.resource.data.studentId))
    && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time && changedTime();
   allow update: if signedIn() && changedTime() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && ((own(resource.data.studentId) && resource.data.status=='pending' && (request.resource.data.status=='declined'
      || (request.resource.data.status=='accepted' && projectMemberAfter(resource.data.teamId,resource.data.studentId))))
     || (own(resource.data.ownerId) && ((resource.data.status=='pending' && request.resource.data.status=='revoked')
      || (request.resource.data.status=='pending' && projectAvailable(resource.data.teamId)
       && !(resource.data.studentId in get(/databases/$(database)/documents/projectTeams/$(resource.data.teamId)).data.members)))));
   allow delete: if false;
  }
  function projectMemberAfter(id,uid) { return uid in getAfter(/databases/$(database)/documents/projectTeams/$(id)).data.members; }
  match /projectTeamRequests/{id} {
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/projectTeamRequests/$(id)) || own(resource.data.studentId) || own(resource.data.ownerId));
   allow list: if signedIn() && (own(resource.data.studentId) || own(resource.data.ownerId));
   allow create: if signedIn() && validProjectEntry(request.resource.data,false) && id==request.resource.data.teamId+'_'+request.auth.uid
    && own(request.resource.data.studentId) && exists(/databases/$(database)/documents/memberProfiles/$(request.auth.uid)) && projectAvailable(request.resource.data.teamId)
    && !(request.auth.uid in get(/databases/$(database)/documents/projectTeams/$(request.resource.data.teamId)).data.members)
    && request.resource.data.status=='pending' && request.resource.data.createdAt==request.time && changedTime();
   allow update: if signedIn() && changedTime() && validProjectEntry(request.resource.data,false)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','note','updatedAt'])
    && ((own(resource.data.studentId) && ((resource.data.status=='pending' && request.resource.data.status=='withdrawn')
     || (resource.data.status in ['declined','withdrawn'] && request.resource.data.status=='pending' && projectAvailable(resource.data.teamId))))
     || (own(resource.data.ownerId) && resource.data.status=='pending' && request.resource.data.note==resource.data.note
      && (request.resource.data.status=='declined' || (request.resource.data.status=='accepted' && projectMemberAfter(resource.data.teamId,resource.data.studentId)))));
   allow delete: if false;
  }

  match /studyFields/{id} {
   allow read: if signedIn();
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['code','enabled'])
    && request.resource.data.code is string && request.resource.data.code.size() >= 3 && request.resource.data.code.size() <= 180
    && request.resource.data.enabled is bool;
   allow delete: if false;
  }
  function mobileConnectionStatus(a,b,status) {
   return exists(/databases/$(database)/documents/connections/$(a+'_'+b)) && get(/databases/$(database)/documents/connections/$(a+'_'+b)).data.status==status;
  }
  match /mobileSharing/{uid} {
   allow get: if own(uid) || (signedIn() && resource != null
    && resource.data.mobile==get(/databases/$(database)/documents/users/$(uid)).data.mobile
    && !mobileConnectionStatus(request.auth.uid,uid,'blocked') && !mobileConnectionStatus(uid,request.auth.uid,'blocked')
    && (resource.data.visibility=='everyone' || (resource.data.visibility=='connections'
     && (mobileConnectionStatus(request.auth.uid,uid,'accepted') || mobileConnectionStatus(uid,request.auth.uid,'accepted')))));
   allow list: if false;
   allow create,update: if own(uid) && request.resource.data.keys().hasAll(['uid','mobile','visibility','updatedAt'])
    && request.resource.data.keys().hasOnly(['uid','mobile','visibility','updatedAt'])
    && request.resource.data.uid==uid && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[+]91[0-9]{10}$')
    && request.resource.data.mobile==getAfter(/databases/$(database)/documents/users/$(uid)).data.mobile
    && request.resource.data.visibility in ['only_me','none','everyone','connections'] && changedTime();
   allow delete: if own(uid);
  }
  function validProjectReference(d) {
   return d.keys().hasAll(['id','title','sourceTitle','section','summary','skills','sourceUrl','sourceKind','notice','status','sourceDocument','sortOrder','createdAt','updatedAt'])
    && d.keys().hasOnly(['id','title','sourceTitle','section','summary','skills','sourceUrl','sourceKind','notice','status','sourceDocument','sortOrder','createdAt','updatedAt'])
    && d.id is string && d.id.matches('fyp-[a-f0-9]{20}') && text(d.title,180) && d.title.size()>0 && text(d.sourceTitle,180) && d.sourceTitle.size()>0
    && d.section in ['Java', 'Core Java', 'Python', 'React', 'Full stack', 'Data science', 'C++', 'Machine learning', 'AI & machine learning', 'IoT', 'Blockchain', 'Language technology', 'EdTech', 'HealthTech'] && text(d.summary,500) && d.summary.size()>0 && validSkills(d.skills) && d.skills.size()>0 && d.skills.size()<=6
    && d.sourceKind in ['repository','collection','article','idea']
    && (d.sourceKind=='idea' ? d.sourceUrl==null : (d.sourceUrl is string && d.sourceUrl.size()<=1000 && d.sourceUrl.matches('https://(github[.]com/|www[.]interviewbit[.]com/).*')))
    && text(d.notice,400) && d.status in ['published','hidden'] && d.sourceDocument=='Final Year Projects.docx'
    && d.sortOrder is int && d.sortOrder>=0 && d.sortOrder<=10000 && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  // Curated references contain no student data. Hidden is a display state, not a privacy setting.
  match /projectLibrary/{id} {
   allow read: if true;
   allow create: if admin() && validProjectReference(request.resource.data) && request.resource.data.id==id && request.resource.data.createdAt==request.time && changedTime();
   allow update: if admin() && validProjectReference(request.resource.data) && request.resource.data.id==id && request.resource.data.createdAt==resource.data.createdAt && changedTime();
   allow delete: if admin();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
