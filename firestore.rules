rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
  function own(uid) { return signedIn() && request.auth.uid == uid; }
  function text(v, max) { return v is string && v.size() <= max; }
  function changedTime() { return request.resource.data.updatedAt == request.time; }
  function skillAt(s, i) { return s.size() <= i || (s[i] is string && s[i].size() > 0 && s[i].size() <= 60); }
  function validSkills(s) {
   return s is list && s.size() <= 20 && s.toSet().size() == s.size()
    && skillAt(s, 0)
    && skillAt(s, 1)
    && skillAt(s, 2)
    && skillAt(s, 3)
    && skillAt(s, 4)
    && skillAt(s, 5)
    && skillAt(s, 6)
    && skillAt(s, 7)
    && skillAt(s, 8)
    && skillAt(s, 9)
    && skillAt(s, 10)
    && skillAt(s, 11)
    && skillAt(s, 12)
    && skillAt(s, 13)
    && skillAt(s, 14)
    && skillAt(s, 15)
    && skillAt(s, 16)
    && skillAt(s, 17)
    && skillAt(s, 18)
    && skillAt(s, 19)
   ;
  }
  function validProfile(d) {
   return d.keys().hasAll(['name','email','college','degree','graduationYear','city','bio','skills','portfolio','resumePath','createdAt','updatedAt'])
    && d.keys().hasOnly(['name','email','college','degree','graduationYear','city','bio','skills','portfolio','resumePath','createdAt','updatedAt'])
    && text(d.name,100) && text(d.email,320) && text(d.college,180) && text(d.degree,100)
    && text(d.graduationYear,4) && d.graduationYear.matches('^(20[0-9]{2}|2100)?$') && text(d.city,100) && text(d.bio,1500)
    && validSkills(d.skills) && text(d.portfolio,500)
    && (d.portfolio == '' || d.portfolio.matches('https://.*'))
    && (d.resumePath == '' || d.resumePath == 'resumes/' + request.auth.uid + '/resume.pdf')
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /users/{uid} {
   allow read: if own(uid) || admin();
   allow create: if own(uid) && validProfile(request.resource.data)
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if own(uid) && validProfile(request.resource.data)
    && request.resource.data.email == resource.data.email
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if false;
  }
  function validListing(d) {
   return d.keys().hasAll(['title','organization','type','category','mode','location','duration','stipend','skills','deadline','closesAt','description','responsibilities','eligibility','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','organization','type','category','mode','location','duration','stipend','skills','deadline','closesAt','description','responsibilities','eligibility','status','createdBy','createdAt','updatedAt'])
    && text(d.title,180) && d.title.size()>0 && text(d.organization,180) && d.organization.size()>0
    && d.type in ['internship','job','competition','hackathon']
    && d.category in ['Technology','Design','Marketing','Business','Finance','Other']
    && d.mode in ['Remote','On-site','Hybrid'] && text(d.location,180) && text(d.duration,180)
    && d.stipend is number && d.stipend>=0 && d.stipend<=10000000
    && validSkills(d.skills) && text(d.deadline,50) && d.closesAt is timestamp
    && text(d.description,6000) && text(d.responsibilities,6000) && text(d.eligibility,6000)
    && d.status in ['draft','published','closed'] && d.createdBy is string
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /opportunities/{id} {
   allow read: if resource.data.status == 'published' || admin();
   allow create: if admin() && validListing(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && changedTime()
    && request.resource.data.closesAt > request.time;
   allow update: if admin() && validListing(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if false;
  }
  match /applications/{id} {
   // Owners can read their deterministic ID before creation for duplicate-safe transactions.
   allow get: if admin() || (signedIn() && id.matches(request.auth.uid + '_.*'));
   allow list: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['studentId','opportunityId','opportunityTitle','organization','studentName','college','resumePath','coverNote','status','createdAt','updatedAt'])
    && request.resource.data.studentId == request.auth.uid
    && text(request.resource.data.opportunityId,128)
    && id == request.auth.uid + '_' + request.resource.data.opportunityId
    && request.resource.data.status == 'submitted'
    && request.resource.data.createdAt == request.time && changedTime()
    && text(request.resource.data.coverNote,2000)
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.studentName.size()>0
    && request.resource.data.college == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.college
    && request.resource.data.college.size()>0
    && request.resource.data.resumePath == 'resumes/' + request.auth.uid + '/resume.pdf'
    && request.resource.data.resumePath == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.resumePath
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'published'
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.closesAt > request.time
    && request.resource.data.opportunityTitle == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.title
    && request.resource.data.organization == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organization;
   allow update: if admin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status in ['submitted','under_review','shortlisted','selected','rejected'] && changedTime();
   allow delete: if false;
  }
  match /bookmarks/{id} {
   allow read: if signedIn() && resource.data.studentId == request.auth.uid;
   allow create: if signedIn()
    && request.resource.data.keys().hasOnly(['studentId','opportunityId','title','organization','type','createdAt'])
    && request.resource.data.studentId == request.auth.uid
    && text(request.resource.data.opportunityId,128)
    && id == request.auth.uid + '_' + request.resource.data.opportunityId
    && request.resource.data.createdAt == request.time
    && request.resource.data.title == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.title
    && request.resource.data.organization == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.organization
    && request.resource.data.type == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.type
    && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.status == 'published';
   allow delete: if signedIn() && resource.data.studentId == request.auth.uid;
   allow update: if false;
  }
  function validTask(d) {
   return d.keys().hasAll(['studentId','title','note','dueDate','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','title','note','dueDate','status','createdAt','updatedAt'])
    && d.studentId is string && text(d.title,120) && d.title.size()>0 && text(d.note,1000)
    && d.dueDate is string && d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.status in ['todo','done'] && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /careerTasks/{id} {
   allow read: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
   allow create: if signedIn() && validTask(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.status == 'todo'
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if signedIn() && (resource.data.studentId == request.auth.uid || admin())
    && validTask(request.resource.data) && request.resource.data.studentId == resource.data.studentId
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if signedIn() && (resource.data.studentId == request.auth.uid || admin());
  }
  function validResource(d) {
   return d.keys().hasAll(['title','description','url','category','status','createdBy','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','description','url','category','status','createdBy','createdAt','updatedAt'])
    && text(d.title,120) && d.title.size()>0 && text(d.description,1000) && d.description.size()>0
    && text(d.url,1000) && d.url.matches('https://[^ /]+.*')
    && d.category in ['Interview prep','Resume & portfolio','Technical skills','Career guidance']
    && d.status in ['draft','published'] && d.createdBy is string
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /resources/{id} {
   allow read: if resource.data.status == 'published' || admin();
   allow create: if admin() && validResource(request.resource.data)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if admin() && validResource(request.resource.data)
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt && changedTime();
   allow delete: if admin();
  }
  function validCommunity(d) {
   return text(d.studentId,128) && d.studentId.size()>0 && text(d.studentName,100) && d.studentName.size()>0
    && text(d.title,120) && d.title.size()>0 && text(d.summary,2000) && d.summary.size()>0
    && d.category in ['Web & apps','AI & data','Design','Hardware','Social impact','Other']
    && validSkills(d.skills) && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  function optionalHttps(v) { return text(v,500) && (v == '' || v.matches('https://[^ /]+.*')); }
  function validProject(d) {
   return d.keys().hasAll(['studentId','studentName','title','summary','category','skills','visibility','moderation','repoUrl','demoUrl','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','title','summary','category','skills','visibility','moderation','repoUrl','demoUrl','createdAt','updatedAt'])
    && validCommunity(d) && d.visibility in ['private','public'] && d.moderation in ['visible','hidden']
    && optionalHttps(d.repoUrl) && optionalHttps(d.demoUrl);
  }
  match /projects/{id} {
   allow read: if (resource.data.visibility == 'public' && resource.data.moderation == 'visible') || own(resource.data.studentId) || admin();
   allow create: if signedIn() && validProject(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.moderation == 'visible'
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if validProject(request.resource.data) && changedTime()
    && request.resource.data.studentId == resource.data.studentId && request.resource.data.studentName == resource.data.studentName
    && request.resource.data.createdAt == resource.data.createdAt
    && (admin() || (own(resource.data.studentId) && resource.data.moderation == 'visible' && request.resource.data.moderation == resource.data.moderation));
   allow delete: if own(resource.data.studentId) || admin();
  }
  function validTeam(d) {
   return d.keys().hasAll(['studentId','studentName','title','summary','category','skills','lookingFor','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','title','summary','category','skills','lookingFor','status','createdAt','updatedAt'])
    && validCommunity(d) && text(d.lookingFor,180) && d.lookingFor.size()>0 && d.status in ['open','closed','hidden'];
  }
  match /teams/{id} {
   allow read: if signedIn() && (resource.data.status != 'hidden' || own(resource.data.studentId) || admin());
   allow create: if signedIn() && validTeam(request.resource.data)
    && request.resource.data.studentId == request.auth.uid && request.resource.data.status in ['open','closed']
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.createdAt == request.time && changedTime();
   allow update: if validTeam(request.resource.data) && changedTime()
    && request.resource.data.studentId == resource.data.studentId && request.resource.data.studentName == resource.data.studentName
    && request.resource.data.createdAt == resource.data.createdAt
    && (admin() || (own(resource.data.studentId) && resource.data.status != 'hidden' && request.resource.data.status in ['open','closed']));
   // Close teams instead of deleting them: existing request references stay valid.
   allow delete: if false;
  }
  function validTeamRequest(d) {
   return d.keys().hasAll(['studentId','studentName','ownerId','teamId','teamTitle','note','status','createdAt','updatedAt'])
    && d.keys().hasOnly(['studentId','studentName','ownerId','teamId','teamTitle','note','status','createdAt','updatedAt'])
    && text(d.studentId,128) && text(d.studentName,100) && d.studentName.size()>0
    && text(d.ownerId,128) && text(d.teamId,128) && d.teamId.size()>0 && text(d.teamTitle,120)
    && text(d.note,1000) && d.note.size()>0 && d.status in ['pending','accepted','declined','withdrawn']
    && d.createdAt is timestamp && d.updatedAt is timestamp;
  }
  match /teamRequests/{id} {
   // Missing-document reads contain no private data and enable duplicate-safe transactions.
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/teamRequests/$(id)) || own(resource.data.studentId) || own(resource.data.ownerId) || admin());
   allow list: if signedIn() && (own(resource.data.studentId) || own(resource.data.ownerId) || admin());
   allow create: if signedIn() && validTeamRequest(request.resource.data)
    && request.resource.data.studentId == request.auth.uid
    && id == request.auth.uid + '_' + request.resource.data.teamId
    && request.resource.data.studentName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
    && request.resource.data.ownerId == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.studentId
    && request.resource.data.ownerId != request.auth.uid
    && request.resource.data.teamTitle == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.title
    && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.status == 'open'
    && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && changedTime();
   allow update: if signedIn() && validTeamRequest(request.resource.data) && changedTime()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && ((own(resource.data.studentId) && resource.data.status in ['pending','accepted'] && request.resource.data.status == 'withdrawn')
     || ((own(resource.data.ownerId) || admin()) && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']));
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
