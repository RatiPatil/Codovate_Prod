# ============================================================
# CODOVATE BACKEND — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# All values below must be set on the production VPS environment.
# DO NOT commit real values. This is a documentation template only.
# Firebase project: codovateprod
# ============================================================

NODE_ENV=production
PORT=5000
FRONTEND_URL=https://codovate.in

# ── Security ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_MIN_64_CHARS

# ── Firebase Admin SDK (codovateprod project) ─────────────────
# Obtain from Firebase Console > Project Settings > Service Accounts
# https://console.firebase.google.com/project/codovateprod/settings/serviceaccounts/adminsdk
FIREBASE_PROJECT_ID=codovateprod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@codovateprod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=codovateprod.firebasestorage.app

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Optional integrations ─────────────────────────────────────
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
