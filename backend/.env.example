# ============================================================
# CODOVATE BACKEND — DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env and fill in actual values.
# DO NOT commit .env or any file containing real credentials.
# Firebase project: codovateprod
# ============================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
FRONTEND_URL=http://localhost:5173

# ── Firebase Admin SDK ────────────────────────────────────────
# Option A: Individual env vars (recommended for CI/cloud)
FIREBASE_PROJECT_ID=codovateprod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@codovateprod.iam.gserviceaccount.com
# Paste the private_key field value from your Firebase service account JSON
FIREBASE_PRIVATE_KEY="<PASTE_FIREBASE_PRIVATE_KEY_FROM_SERVICE_ACCOUNT_JSON>"
FIREBASE_STORAGE_BUCKET=codovateprod.firebasestorage.app

# Option B: Full JSON string (alternative to Option A)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"codovateprod",...}

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional integrations ─────────────────────────────────────
GITHUB_TOKEN=your_github_token_here
