{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hackathon reference directory \u2014 not live event editions",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "group",
      "kind",
      "summary",
      "modes",
      "location",
      "interests",
      "skills",
      "sourceUrl",
      "registrationOpensAt",
      "deadline",
      "publishedAt",
      "prizeINR",
      "note",
      "schedule"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "group": {
        "enum": [
          "Global & Major Hackathons",
          "Indian Hackathons",
          "Tech Company Hackathons",
          "Platform-Based Hackathons",
          "Specialty Hackathons",
          "Regional & International Hackathons",
          "University Hackathons (US & Global)"
        ]
      },
      "kind": {
        "enum": [
          "event-series",
          "platform",
          "program"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "modes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "Remote",
            "On-site",
            "Hybrid"
          ]
        }
      },
      "location": {
        "type": "string"
      },
      "interests": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "Technology",
            "Design",
            "Marketing",
            "Business",
            "Finance",
            "Other"
          ]
        }
      },
      "skills": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "sourceUrl": {
        "type": [
          "string",
          "null"
        ],
        "format": "uri",
        "pattern": "^https://[^/@]+(?:/|$)"
      },
      "registrationOpensAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "deadline": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "publishedAt": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "prizeINR": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "note": {
        "type": "string",
        "maxLength": 1000
      },
      "schedule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "edition",
          "eventStartDate",
          "eventEndDate",
          "registrationOpensDate",
          "registrationDeadlineDate",
          "registration",
          "dateText",
          "checkedOn",
          "sourceUrl",
          "timeZone",
          "note"
        ],
        "properties": {
          "state": {
            "enum": [
              "dated",
              "multiple",
              "partial",
              "unannounced",
              "paused",
              "unavailable",
              "conflicting"
            ]
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventStartDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "eventEndDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "registrationOpensDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "registrationDeadlineDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "registration": {
            "enum": [
              "open",
              "closed",
              "not-open",
              "unconfirmed"
            ]
          },
          "dateText": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkedOn": {
            "type": "string",
            "format": "date"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https://[^/@]+(?:/|$)"
          },
          "timeZone": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
