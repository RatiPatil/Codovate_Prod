{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated final-year project library seed",
  "type": "array",
  "minItems": 90,
  "maxItems": 500,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "sourceTitle",
      "section",
      "summary",
      "skills",
      "sourceUrl",
      "sourceKind",
      "notice",
      "status",
      "sourceDocument",
      "sortOrder",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^fyp-[a-f0-9]{20}$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "sourceTitle": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "section": {
        "enum": [
          "Java",
          "Core Java",
          "Python",
          "React",
          "Full stack",
          "Data science",
          "C++",
          "Machine learning",
          "AI & machine learning",
          "IoT",
          "Blockchain",
          "Language technology",
          "EdTech",
          "HealthTech",
          "Python & Django collections",
          "Deep learning collections",
          "NLP collections",
          "Computer vision collections",
          "ML engineering collections",
          "AI & ML collections",
          "Geospatial projects"
        ]
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "skills": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "sourceUrl": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "format": "uri",
            "maxLength": 1000,
            "pattern": "^https://(github\\.com|www\\.interviewbit\\.com|data-flair\\.training|www\\.kdnuggets\\.com|notebooks\\.quantumstat\\.com|datasets\\.quantumstat\\.com|projectworlds\\.in|1000projects\\.org)/.*$"
          }
        ]
      },
      "sourceKind": {
        "enum": [
          "repository",
          "collection",
          "article",
          "idea"
        ]
      },
      "notice": {
        "type": "string",
        "maxLength": 400
      },
      "status": {
        "enum": [
          "published",
          "hidden"
        ]
      },
      "sourceDocument": {
        "enum": [
          "Final Year Projects.docx",
          "500 + AI,ML Projects with Source Code.pdf"
        ]
      },
      "sortOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "sourceEntry": {
        "type": "integer",
        "minimum": 31,
        "maximum": 63
      },
      "originalSourceUrl": {
        "type": "string",
        "pattern": "^https://bit[.]ly/[A-Za-z0-9]+$",
        "maxLength": 100
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "sourceKind": {
              "const": "idea"
            }
          }
        },
        "then": {
          "properties": {
            "sourceUrl": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "sourceUrl": {
              "type": "string"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "sourceDocument": {
              "const": "500 + AI,ML Projects with Source Code.pdf"
            }
          },
          "required": [
            "sourceDocument"
          ]
        },
        "then": {
          "required": [
            "sourceEntry",
            "originalSourceUrl"
          ],
          "properties": {
            "sourceKind": {
              "const": "collection"
            }
          }
        },
        "else": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "sourceEntry"
                ]
              },
              {
                "required": [
                  "originalSourceUrl"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
