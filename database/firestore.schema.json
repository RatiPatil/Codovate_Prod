          ]
        },
        "repoUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "format": "uri",
              "pattern": "^https://[^ /]+"
            }
          ]
        },
        "demoUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "maxLength": 500,
              "minLength": 1,
              "format": "uri",
              "pattern": "^https://[^ /]+"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "teams": {
      "type": "object",
      "required": [
        "studentId",
