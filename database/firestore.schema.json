{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codovate.in/schemas/firestore-v1.json",
  "title": "Codovate Firestore document contracts",
  "description": "Timestamp values are normalized to ISO 8601 for validation. Firebase Security Rules enforce live writes. Each $defs entry describes one collection document.",
  "$defs": {
    "users": {
      "type": "object",
      "required": [
        "name",
        "email",
        "college",
        "degree",
        "graduationYear",
        "city",
        "bio",
        "skills",
        "portfolio",
        "resumePath",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 320
        },
        "college": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180
        },
        "degree": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "graduationYear": {
          "type": "string",
          "pattern": "^(20[0-9]{2}|2100)?$"
        },
        "city": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        },
        "skills": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "portfolio": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^$|^https://.+"
        },
        "resumePath": {
          "type": "string",
          "pattern": "^$|^resumes/[^/]+/resume\\.pdf$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resumeUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^ /]+",
              "maxLength": 500
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "opportunities": {
      "type": "object",
      "required": [
        "title",
        "organization",
        "type",
        "category",
        "mode",
        "location",
        "duration",
        "stipend",
        "skills",
        "deadline",
        "closesAt",
        "description",
        "responsibilities",
        "eligibility",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "type": {
          "enum": [
            "internship",
            "job",
            "competition",
            "hackathon"
          ]
        },
        "category": {
          "enum": [
            "Technology",
            "Design",
            "Marketing",
            "Business",
            "Finance",
            "Other"
          ]
        },
        "mode": {
          "enum": [
            "Remote",
            "On-site",
            "Hybrid"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180
        },
        "duration": {
          "type": "string",
          "minLength": 0,
          "maxLength": 180
        },
        "stipend": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "skills": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "closesAt": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6000
        },
        "responsibilities": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6000
        },
        "eligibility": {
          "type": "string",
          "minLength": 0,
          "maxLength": 6000
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "closed"
          ]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "object",
      "required": [
        "studentId",
        "opportunityId",
        "opportunityTitle",
        "organization",
        "studentName",
        "college",
        "resumePath",
        "coverNote",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "opportunityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "opportunityTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "college": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "resumePath": {
          "type": "string",
          "anyOf": [
            {
              "const": ""
            },
            {
              "pattern": "^resumes/[^/]+/resume\\.pdf$"
            }
          ]
        },
        "coverNote": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "status": {
          "enum": [
            "submitted",
            "under_review",
            "shortlisted",
            "selected",
            "rejected"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resumeUrl": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^ /]+",
              "maxLength": 500
            }
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "resumePath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "resumeUrl"
          ],
          "properties": {
            "resumeUrl": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
