{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated external opportunity snapshot (not a Firestore collection)",
  "type": "array",
  "maxItems": 100,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "organization",
      "location",
      "summary",
      "eligibility",
      "compensation",
      "type",
      "mode",
      "category",
      "skills",
      "deadline",
      "sourceUrl",
      "reviewedAt"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "organization": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      },
      "location": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "eligibility": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "compensation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      },
      "type": {
        "enum": [
          "internship",
          "job",
          "hackathon"
        ]
      },
      "mode": {
        "enum": [
          "Remote",
          "On-site",
          "Hybrid",
          "Not specified"
        ]
      },
      "category": {
        "enum": [
          "Technology",
          "Design",
          "Marketing",
          "Business",
          "Finance",
          "Other"
        ]
      },
      "skills": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "deadline": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "format": "date-time"
          }
        ]
      },
      "sourceUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 1000
      },
      "reviewedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": false
  }
}
